Block("Boost FPS", function()
	local BoostOn = false
	local BoostOriginal = setmetatable({}, { __mode = "k" })
	local SavedQuality = nil
	local BoostConns = {}

	local function SetProp(Inst, Prop, Value)
		pcall(function()
			local Saved = BoostOriginal[Inst]

			if not Saved then
				Saved = {}
				BoostOriginal[Inst] = Saved
			end

			if Saved[Prop] == nil then
				Saved[Prop] = Inst[Prop]
			end

			Inst[Prop] = Value
		end)
	end

	local function InCharacter(Inst)
		local Model = Inst:FindFirstAncestorOfClass("Model")
		return Model ~= nil and Model:FindFirstChildOfClass("Humanoid") ~= nil
	end

	local function ReduceInstance(Inst)
		if Inst:IsA("Terrain") then
			return
		end

		if Inst:IsA("BasePart") then
			SetProp(Inst, "Material", Enum.Material.SmoothPlastic)
			SetProp(Inst, "Reflectance", 0)
			SetProp(Inst, "CastShadow", false)
		elseif Inst:IsA("ParticleEmitter") or Inst:IsA("Trail") or Inst:IsA("Smoke")
			or Inst:IsA("Fire") or Inst:IsA("Sparkles") or Inst:IsA("PostEffect") or Inst:IsA("Clouds") then
			SetProp(Inst, "Enabled", false)
		elseif Inst:IsA("Decal") then
			if not InCharacter(Inst) then
				SetProp(Inst, "Transparency", 1)
			end
		elseif Inst:IsA("Atmosphere") then
			SetProp(Inst, "Density", 0)
			SetProp(Inst, "Haze", 0)
		end
	end

	local function EnableBoost()
		pcall(function()
			SavedQuality = settings().Rendering.QualityLevel
			settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
		end)

		SetProp(Lighting, "GlobalShadows", false)
		SetProp(Lighting, "ShadowSoftness", 0)
		SetProp(Lighting, "EnvironmentDiffuseScale", 0)
		SetProp(Lighting, "EnvironmentSpecularScale", 0)

		local Terrain = workspace:FindFirstChildOfClass("Terrain")

		if Terrain then
			SetProp(Terrain, "WaterWaveSize", 0)
			SetProp(Terrain, "WaterWaveSpeed", 0)
			SetProp(Terrain, "WaterReflectance", 0)
			SetProp(Terrain, "Decoration", false)
		end

		for _, Inst in ipairs(Lighting:GetDescendants()) do
			ReduceInstance(Inst)
		end

		table.insert(BoostConns, Lighting.DescendantAdded:Connect(function(Inst)
			if BoostOn then
				ReduceInstance(Inst)
			end
		end))

		table.insert(BoostConns, workspace.DescendantAdded:Connect(function(Inst)
			if BoostOn then
				ReduceInstance(Inst)
			end
		end))

		task.spawn(function()
			local Count = 0

			for _, Inst in ipairs(workspace:GetDescendants()) do
				if not BoostOn then
					return
				end

				ReduceInstance(Inst)
				Count = Count + 1

				if Count % 400 == 0 then
					task.wait()
				end
			end
		end)
	end

	local function DisableBoost()
		for _, C in ipairs(BoostConns) do
			C:Disconnect()
		end

		table.clear(BoostConns)

		for Inst, Props in pairs(BoostOriginal) do
			for Prop, Value in pairs(Props) do
				pcall(function()
					Inst[Prop] = Value
				end)
			end
		end

		table.clear(BoostOriginal)

		if SavedQuality then
			pcall(function()
				settings().Rendering.QualityLevel = SavedQuality
			end)
		end
	end

	local function SetBoostFps(State)
		BoostOn = State

		if State then
			EnableBoost()
		else
			DisableBoost()
		end
	end

	OnCleanup(function()
		BoostOn = false
		DisableBoost()
	end)

	F.SetBoostFps = SetBoostFps
end)

