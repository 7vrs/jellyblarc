Block("Combat (connect/hitbox)", function()
	local ConnectOn = false
	local ConnectRange = 8
	local LastAttackInputAt = -100
	local AttackInputHooked = false
	local LastConnectedSeq = nil
	local ActionToken = 0

	Conn(UserInputService.InputBegan:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1
			or Input.KeyCode == Enum.KeyCode.ButtonR2
			or (IsMobile and not Modules.Input and Input.UserInputType == Enum.UserInputType.Touch) then
			LastAttackInputAt = os.clock()
		end
	end))

	local function AttackInputRecent()
		if os.clock() - LastAttackInputAt <= 0.6 then
			return true
		end

		local HeldDown = false

		pcall(function()
			HeldDown = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
				or UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonR2)
		end)

		return HeldDown
	end

	local function ReportHit(Action)
		local Active = Modules.AttackState and Modules.AttackState.Active
		local Combat = Modules.Combat
		local Character = LocalPlayer.Character

		if not ConnectOn or not Active or not Combat or not Character or not IsAlive() then
			return
		end

		if Active.CurrentM1 ~= Action then
			return
		end

		local StillPlaying = false

		pcall(function()
			StillPlaying = Action.IsPlaying
		end)

		if not StillPlaying then
			return
		end

		local Model = NearestTarget(ConnectRange)

		if not Model then
			return
		end

		local TargetPart = Model:FindFirstChild("UpperTorso")
			or Model:FindFirstChild("Torso")
			or Model:FindFirstChild("HumanoidRootPart")

		if not TargetPart then
			return
		end

		local Limb = ClosestLimb(Character, HAND_PARTS, TargetPart.Position)
		local Seq = Active.Seq

		if type(Seq) ~= "number" or not Limb or LastConnectedSeq == Seq then
			return
		end

		LastConnectedSeq = Seq

		pcall(function()
			Combat.HitReport:Fire(Seq, TargetPart, Limb.Position)
		end)
	end

	local function OnAction(Action)
		ActionToken = ActionToken + 1

		local Mine = ActionToken
		local Fired = false
		local Marker = nil

		local function Fire()
			if Fired or Mine ~= ActionToken then
				return
			end

			Fired = true

			if Marker then
				Marker:Disconnect()
				Marker = nil
			end

			task.spawn(ReportHit, Action)
		end

		pcall(function()
			Marker = Action:GetMarkerReachedSignal("Start"):Connect(Fire)
		end)

		task.delay(0.1, Fire)
	end

	local LastM1 = nil
	local LastM1Time = 0

	Conn(RunService.Heartbeat:Connect(function()
		if not ConnectOn then
			LastM1 = nil
			return
		end

		if not EnsureModules() then
			return
		end

		if not AttackInputHooked and Modules.Input then
			AttackInputHooked = true

			pcall(function()
				Modules.Input.Began:Connect(function(Action)
					if Action == "Attack" then
						LastAttackInputAt = os.clock()
					end
				end)
			end)
		end

		local Active = Modules.AttackState.Active
		local M1 = Active and Active.CurrentM1

		if not M1 then
			LastM1 = nil
			return
		end

		local Playing = false
		local TimePos = 0

		pcall(function()
			Playing = M1.IsPlaying
			TimePos = M1.TimePosition
		end)

		local Restarted = Playing and M1 == LastM1 and TimePos + 0.02 < LastM1Time
		LastM1Time = TimePos

		if Playing and (M1 ~= LastM1 or Restarted) then
			LastM1 = M1

			if AttackInputRecent() then
				OnAction(M1)
			end
		elseif not Playing then
			LastM1 = nil
		end
	end))

	local function SetAutoConnect(State)
		ConnectOn = State
		LastM1 = nil

		if State then
			task.spawn(LoadModules)
		end
	end

	local HitboxOn = false
	local SmartOn = false
	local HITBOX_RANGE = 7
	local HITBOX_TRANSPARENCY = 0.7
	local HitboxTracked = {}
	local HitboxLastSync = 0
	local DownedUntil = setmetatable({}, { __mode = "k" })
	local DOWN_HOLD = 0.6

	local DOWN_ATTRIBUTES = { "Ragdoll", "Ragdolled", "Knocked", "KnockedDown", "Downed", "Crit", "Crited", "Stunned" }

	local DOWN_STATES = {
		[Enum.HumanoidStateType.FallingDown] = true,
		[Enum.HumanoidStateType.Ragdoll] = true,
		[Enum.HumanoidStateType.Physics] = true,
		[Enum.HumanoidStateType.PlatformStanding] = true,
		[Enum.HumanoidStateType.Dead] = true,
	}

	local function HitboxActive()
		return HitboxOn or SmartOn
	end

	local function IsDowned(Root)
		local Model = Root.Parent
		local Humanoid = Model and Model:FindFirstChildOfClass("Humanoid")

		if not Humanoid then
			return false
		end

		local Now = os.clock()
		local Down = false

		local Ok, State = pcall(function()
			return Humanoid:GetState()
		end)

		if Ok and DOWN_STATES[State] then
			Down = true
		end

		if not Down and Humanoid.PlatformStand then
			Down = true
		end

		if not Down then
			for _, Name in ipairs(DOWN_ATTRIBUTES) do
				if Model:GetAttribute(Name) == true or Humanoid:GetAttribute(Name) == true then
					Down = true
					break
				end
			end
		end

		if not Down and Root.CFrame.UpVector.Y < 0.55 then
			Down = true
		end

		if Down then
			DownedUntil[Root] = Now + DOWN_HOLD
			return true
		end

		local Until = DownedUntil[Root]

		return Until ~= nil and Now < Until
	end

	local function RestoreHitbox(Root)
		local Data = HitboxTracked[Root]

		if not Data then
			return
		end

		HitboxTracked[Root] = nil

		for _, C in ipairs(Data.Conns) do
			C:Disconnect()
		end

		if Root.Parent then
			pcall(function()
				Root.Size = Data.Size
				Root.Transparency = Data.Transparency
				Root.Color = Data.Color
				Root.Material = Data.Material
				Root.CanCollide = Data.CanCollide
			end)
		end
	end

	local function ShapeHitbox(Root)
		local Target = Vector3.new(HITBOX_RANGE, HITBOX_RANGE, HITBOX_RANGE)

		if Root.Size ~= Target then
			Root.Size = Target
		end

		Root.Transparency = HITBOX_TRANSPARENCY
		Root.CanCollide = false
	end

	local function TrackHitbox(Root)
		if HitboxTracked[Root] then
			return
		end

		local Data = {
			Size = Root.Size,
			Transparency = Root.Transparency,
			Color = Root.Color,
			Material = Root.Material,
			CanCollide = Root.CanCollide,
			Conns = {},
		}

		HitboxTracked[Root] = Data

		Root.Color = Color3.new(0, 0, 0)
		Root.Material = Enum.Material.SmoothPlastic

		table.insert(Data.Conns, Root:GetPropertyChangedSignal("Size"):Connect(function()
			if HitboxActive() then
				local Target = Vector3.new(HITBOX_RANGE, HITBOX_RANGE, HITBOX_RANGE)

				if Root.Size ~= Target then
					Root.Size = Target
				end
			end
		end))

		ShapeHitbox(Root)
	end

	local function GetHitboxTargets()
		local List = {}
		local Seen = {}
		local MyCharacter = LocalPlayer.Character

		local function Add(Model)
			if not Model or Model == MyCharacter or not Model:IsA("Model") then
				return
			end

			local Root = Model:FindFirstChild("HumanoidRootPart")

			if Root and Root:IsA("BasePart") and not Seen[Root] and Model:FindFirstChildOfClass("Humanoid") then
				Seen[Root] = true
				List[#List + 1] = Root
			end
		end

		for _, Player in ipairs(Players:GetPlayers()) do
			if Player ~= LocalPlayer then
				Add(Player.Character)
			end
		end

		local Live = workspace:FindFirstChild("Live")

		if Live then
			for _, Child in ipairs(Live:GetChildren()) do
				Add(Child)
			end
		end

		for _, Child in ipairs(workspace:GetChildren()) do
			Add(Child)
		end

		return List
	end

	local function SyncHitboxes()
		local Present = {}

		for _, Root in ipairs(GetHitboxTargets()) do
			local Humanoid = Root.Parent and Root.Parent:FindFirstChildOfClass("Humanoid")

			if Humanoid and Humanoid.Health > 0 and not (SmartOn and IsDowned(Root)) then
				Present[Root] = true
				TrackHitbox(Root)
			end
		end

		for Root in pairs(HitboxTracked) do
			if not Present[Root] or not Root.Parent then
				RestoreHitbox(Root)
			end
		end
	end

	local function RestoreAllHitboxes()
		for Root in pairs(HitboxTracked) do
			RestoreHitbox(Root)
		end
	end

	local ReachTable = nil
	local ReachOriginal = {}
	local ReachSearched = false

	local function FindReach()
		if ReachSearched then
			return ReachTable
		end

		ReachSearched = true

		pcall(function()
			for _, Inst in ipairs(ReplicatedStorage:GetDescendants()) do
				if Inst:IsA("ModuleScript") and Inst.Name == "Config" then
					local Ok, Result = pcall(require, Inst)

					if Ok and type(Result) == "table" and type(Result.Combat) == "table" and type(Result.Combat.Reach) == "table" then
						ReachTable = Result.Combat.Reach

						for Key, Value in pairs(ReachTable) do
							if type(Value) == "number" then
								ReachOriginal[Key] = Value
							end
						end

						return
					end
				end
			end
		end)

		return ReachTable
	end

	local function ApplyReach()
		local Reach = FindReach()

		if not Reach then
			return
		end

		local Factor = math.max(HITBOX_RANGE / (ReachOriginal.Bare or 7), 1)

		pcall(function()
			for Key, Value in pairs(ReachOriginal) do
				Reach[Key] = Value * Factor
			end
		end)
	end

	local function RestoreReach()
		if not ReachTable then
			return
		end

		pcall(function()
			for Key, Value in pairs(ReachOriginal) do
				ReachTable[Key] = Value
			end
		end)
	end

	Conn(RunService.Stepped:Connect(function()
		if not HitboxActive() then
			return
		end

		local Now = os.clock()

		if Now - HitboxLastSync >= 0.25 then
			HitboxLastSync = Now
			SyncHitboxes()
		end

		for Root in pairs(HitboxTracked) do
			if Root.Parent then
				if SmartOn and IsDowned(Root) then
					RestoreHitbox(Root)
				else
					ShapeHitbox(Root)
				end
			end
		end
	end))

	local function RefreshHitbox()
		if HitboxActive() then
			SyncHitboxes()
			ApplyReach()
		else
			RestoreAllHitboxes()
			RestoreReach()
		end
	end

	local function SetHitbox(State)
		HitboxOn = State
		RefreshHitbox()
	end

	local function SetSmartHitbox(State)
		SmartOn = State
		RefreshHitbox()
	end

	local function SetHitboxRange(Value)
		HITBOX_RANGE = Value

		if HitboxActive() then
			for Root in pairs(HitboxTracked) do
				if Root.Parent then
					ShapeHitbox(Root)
				end
			end

			ApplyReach()
		end
	end

	local function SetHitboxTransparency(Value)
		HITBOX_TRANSPARENCY = Value

		for Root in pairs(HitboxTracked) do
			if Root.Parent then
				Root.Transparency = Value
			end
		end
	end

	OnCleanup(function()
		ConnectOn = false
		HitboxOn = false
		SmartOn = false
		RestoreAllHitboxes()
		RestoreReach()
	end)

	F.SetAutoConnect = SetAutoConnect
	F.SetConnectRange = function(Value)
		ConnectRange = Value
	end
	F.SetSmartHitbox = SetSmartHitbox
	F.SetHitbox = SetHitbox
	F.SetHitboxRange = SetHitboxRange
	F.SetHitboxTransparency = SetHitboxTransparency
end)

