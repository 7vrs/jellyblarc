Block("Camera", function()
	local FovOn = false
	local FovValue = 70
	local FovOriginal = nil

	local StretchOn = false
	local StretchValue = 0.75

	pcall(function()
		RunService:UnbindFromRenderStep("JellyFov")
	end)

	RunService:BindToRenderStep("JellyFov", Enum.RenderPriority.Camera.Value + 2, function()
		if not FovOn then
			return
		end

		local Camera = workspace.CurrentCamera

		if Camera and Camera.FieldOfView ~= FovValue then
			Camera.FieldOfView = FovValue
		end
	end)

	pcall(function()
		RunService:UnbindFromRenderStep("JellyStretch")
	end)

	RunService:BindToRenderStep("JellyStretch", Enum.RenderPriority.Camera.Value + 3, function()
		if not StretchOn then
			return
		end

		local Camera = workspace.CurrentCamera

		if Camera then
			Camera.CFrame = Camera.CFrame * CFrame.new(0, 0, 0, 1, 0, 0, 0, StretchValue, 0, 0, 0, 1)
		end
	end)

	local function SetFov(State)
		local Camera = workspace.CurrentCamera

		if State then
			FovOriginal = Camera and Camera.FieldOfView or 70
		elseif Camera and FovOriginal then
			Camera.FieldOfView = FovOriginal
		end

		FovOn = State
	end

	local function SetStretch(State)
		StretchOn = State
	end

	local UserGameSettings = UserSettings():GetService("UserGameSettings")
	local SensOriginal = 1
	local GamepadSensOriginal = nil
	local SensChanged = false

	pcall(function()
		SensOriginal = UserGameSettings.MouseSensitivity
	end)

	pcall(function()
		GamepadSensOriginal = UserGameSettings.GamepadCameraSensitivity
	end)

	local function SetSensitivity(Value)
		SensChanged = true

		pcall(function()
			UserGameSettings.MouseSensitivity = Value
		end)

		if GamepadSensOriginal and SensOriginal > 0 then
			pcall(function()
				UserGameSettings.GamepadCameraSensitivity = GamepadSensOriginal * (Value / SensOriginal)
			end)
		end
	end

	OnCleanup(function()
		pcall(function()
			RunService:UnbindFromRenderStep("JellyFov")
		end)

		pcall(function()
			RunService:UnbindFromRenderStep("JellyStretch")
		end)

		if SensChanged then
			pcall(function()
				UserGameSettings.MouseSensitivity = SensOriginal
			end)

			if GamepadSensOriginal then
				pcall(function()
					UserGameSettings.GamepadCameraSensitivity = GamepadSensOriginal
				end)
			end
		end
	end)

	F.SetFov = SetFov
	F.SetFovValue = function(Value)
		FovValue = Value
	end
	F.SetStretch = SetStretch
	F.SetStretchValue = function(Value)
		StretchValue = Value
	end
	F.SetSensitivity = SetSensitivity
	F.SensOriginal = SensOriginal
end)

