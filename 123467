		if BubbleDragging and IsMove(input) then
			local d = input.Position - BubbleStart

			if d.Magnitude > 6 then
				BubbleMoved = true
			end

			if BubbleMoved then
				Bubble.Position = UDim2.new(
					BubblePos.X.Scale, BubblePos.X.Offset + d.X,
					BubblePos.Y.Scale, BubblePos.Y.Offset + d.Y
				)
			end
		end
	end))

	Conn(UserInputService.InputEnded:Connect(function(input)
		if BubbleDragging and IsPress(input) then
			BubbleDragging = false

			if not BubbleMoved then
				Main.Visible = not Main.Visible
			end
		end
	end))

