do
	local Dragging, DragStart, StartPos = false, nil, nil

	Conn(Header.InputBegan:Connect(function(input)
		if IsPress(input) then
			Dragging, DragStart, StartPos = true, input.Position, Main.Position
		end
	end))

	Conn(UserInputService.InputChanged:Connect(function(input)
		if Dragging and IsMove(input) then
			local d = input.Position - DragStart

			Main.Position = UDim2.new(
				StartPos.X.Scale, StartPos.X.Offset + d.X,
				StartPos.Y.Scale, StartPos.Y.Offset + d.Y
			)
		end
	end))

	Conn(UserInputService.InputEnded:Connect(function(input)
		if IsPress(input) then
			Dragging = false
		end
	end))
end

do
	local Resizing, StartMouse, StartSize = false, nil, nil

	Conn(Grip.InputBegan:Connect(function(input)
		if IsPress(input) then
			Resizing, StartMouse, StartSize = true, input.Position, Main.AbsoluteSize
		end
	end))

	Conn(UserInputService.InputChanged:Connect(function(input)
		if Resizing and IsMove(input) then
			local d = input.Position - StartMouse

			Main.Size = UDim2.fromOffset(
				math.clamp(StartSize.X + d.X, MIN_W, MAX_W),
				math.clamp(StartSize.Y + d.Y, MIN_H, MAX_H)
			)
		end
	end))

	Conn(UserInputService.InputEnded:Connect(function(input)
		if IsPress(input) then
			Resizing = false
		end
	end))
end

Conn(UserInputService.InputBegan:Connect(function(input, processed)
	if input.KeyCode == Enum.KeyCode.ButtonSelect then
		Main.Visible = not Main.Visible
		return
	end

	if not processed and input.KeyCode == Enum.KeyCode.RightControl then
		Main.Visible = not Main.Visible
	end
end))

