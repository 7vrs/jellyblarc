		end
	end

	local function SetWalkValue(Value)
		local WasCustom = WalkCustom()
		WalkSetting = Value

		if WasCustom and not WalkCustom() then
			RestoreWalkSpeed()
		end
	end

	local SLIDE_IDS = {
		"18312351760", "18312346524", "18312348771", "18312344029",
		"17819695187", "17819683172", "17819691229", "17819688197",
	}

	local SlideHumanoid = nil
	local SlideRoot = nil
	local SlideAnimator = nil
	local SlideWasWeaving = false
	local SlideFallback = 11

	local function SlideIsWeaving()
		if Weaving then
			return true
		end

		if not SlideAnimator then
			return false
		end

		for _, Track in ipairs(SlideAnimator:GetPlayingAnimationTracks()) do
			if Track.IsPlaying and Track.Animation then
				local AnimId = tostring(Track.Animation.AnimationId)

				for _, Id in ipairs(SLIDE_IDS) do
					if string.find(AnimId, Id, 1, true) then
						return true
					end
				end
			end
		end

		return false
	end

	local function BindSlide(Character)
		SlideHumanoid = nil
		SlideRoot = nil
		SlideAnimator = nil
		SlideWasWeaving = false

		if not Character then
			return
		end

		local Humanoid = Character:WaitForChild("Humanoid", 5)
		local Root = Character:WaitForChild("HumanoidRootPart", 5)

		if not Humanoid or not Root then
			return
		end

		SlideHumanoid = Humanoid
		SlideRoot = Root
		SlideAnimator = Humanoid:FindFirstChildOfClass("Animator") or Humanoid:WaitForChild("Animator", 5)
	end

	if LocalPlayer.Character then
		task.spawn(BindSlide, LocalPlayer.Character)
	end

	Conn(LocalPlayer.CharacterAdded:Connect(function(Character)
		task.spawn(BindSlide, Character)
	end))

	Conn(RunService.RenderStepped:Connect(function()
		if not SlideOn or not SlideHumanoid or SlideHumanoid.Health <= 0 then
			SlideWasWeaving = false
			return
		end

		if SlideIsWeaving() then
			SlideWasWeaving = true
			SlideHumanoid.WalkSpeed = SlideSpeed
			SlideHumanoid.AutoRotate = true

			if SlideRoot then
				for _, Child in ipairs(SlideRoot:GetChildren()) do
					if Child:IsA("LinearVelocity") or Child:IsA("BodyVelocity")
						or Child:IsA("VectorForce") or Child:IsA("BodyThrust") then
						Child:Destroy()
					end
				end

				local Velocity = SlideRoot.AssemblyLinearVelocity
				local Horizontal = Vector3.new(Velocity.X, 0, Velocity.Z)
				local MaxSpeed = SlideSpeed + 1

				if Horizontal.Magnitude > MaxSpeed then
					local Capped = Horizontal.Unit * MaxSpeed
					SlideRoot.AssemblyLinearVelocity = Vector3.new(Capped.X, Velocity.Y, Capped.Z)
				end
			end
		elseif SlideWasWeaving then
			SlideWasWeaving = false
			SlideHumanoid.WalkSpeed = WalkCustom() and WalkSetting or SlideFallback
			SlideHumanoid.AutoRotate = true
		end
	end))

	local function SetSlide(State)
		SlideOn = State

		if not State and SlideWasWeaving and SlideHumanoid then
			SlideWasWeaving = false
			SlideHumanoid.WalkSpeed = WalkCustom() and WalkSetting or SlideFallback
		end
	end

	local function SetSlideSpeed(Value)
		SlideSpeed = Value
	end

	OnCleanup(function()
		WeaveOn = false
		GlideOn = false
		SlideOn = false
		StopWeave()
		UnblockGameWeave()

		if FramesConn then
			FramesConn:Disconnect()
		end

		if ToolConn then
			ToolConn:Disconnect()
		end

		pcall(function()
			RunService:UnbindFromRenderStep("JellyNoSlide")
		end)
	end)

	F.SetWeave = SetWeave
	F.SetGlide = SetGlide
	F.SetGlideDistance = SetGlideDistance
	F.SetWalk = SetWalk
	F.SetWalkValue = SetWalkValue
	F.SetSlide = SetSlide
	F.SetSlideSpeed = SetSlideSpeed
	F.SetLinger = function(Value)
		Linger = Value
	end
	F.GetWeaveTracks = GetWeaveTracks
	F.TrackCache = TrackCache
	F.GetLinger = function()
		return Linger
	end
end)

------------------------------------------------------------------
-- Block 4: Weave Mac V2
-- Slide / direction / animation logic = Isaeva script.
-- Weave signal = same auto weave as the top "Weave Mac" toggle (flip + linger),
-- only active while you hold weave (Space / L2 / mobile weave button) and
-- have activated it with a direction. Never fires just from holding fist.
------------------------------------------------------------------
Block("Movement (weave v2)", function()
	local GetWeaveTracks = F.GetWeaveTracks
	local TrackCache = F.TrackCache or {}

	local V2 = { Enabled = false, Distance = 3.7, Duration = 0.28 }

	local ANIM_SPEED = 1
	local DIAG_SPEED = 18
	local JITTER_STEP = 0.05
	local JITTER_AMOUNT = 0.45
	local JitterAt, JitterFlip = 0, false
	local SLIDE_SMOOTH = 0.012
	local Current = nil
	local Desired = nil
	local Stopped = false

	-- weave signal timing (copied from the top Weave Mac toggle)
	local FLIP_P = 0.27
	local MIN_SPACING = 0.2
	local RECOVER_AFTER = 0.05
	local RECOVER_SPACING = 0.22
	local FAST_SPACING = 0.10

	local Blocked = false
	local OrigSet, OrigPlay, OrigStop, OrigReset

	local function Block2()
		if Blocked or not Modules.Weave then
			return
		end

		local W = Modules.Weave

		local Ok = pcall(function()
			OrigSet, OrigPlay, OrigStop, OrigReset = W.Set, W.Play, W.StopTrack, W.Reset
			W.Set = function() end
			W.Play = function() end
			W.StopTrack = function() end
			W.Reset = function() end
		end)

		if Ok and W.Set ~= OrigSet then
			Blocked = true

			if Modules.AttackState and Modules.AttackState.Active then
				Modules.AttackState.Active.Weaving = false
			end
		else
			pcall(function()
				W.Set = OrigSet or W.Set
				W.Play = OrigPlay or W.Play
				W.StopTrack = OrigStop or W.StopTrack
				W.Reset = OrigReset or W.Reset
			end)
		end
	end

	local function Unblock()
		if Blocked and Modules.Weave then
			pcall(function()
				Modules.Weave.Set, Modules.Weave.Play, Modules.Weave.StopTrack, Modules.Weave.Reset = OrigSet, OrigPlay, OrigStop, OrigReset
			end)
		end

		Blocked = false
	end

	local OwnTrack, OwnLooped = nil, false
	local SlideId = 0
	local Sliding = false
	local Holding = false
	local SavedSpeed = nil
	local ExtraTrack, ExtraLooped = nil, false

	------------------------------------------------------------------
	-- Weave signal (top-toggle logic)
	------------------------------------------------------------------
	local SignalOn = false
	local LingerUntil = nil
	local LastFire = 0
	local PunchFlipAt = nil
	local LastCanAttackPoll = true
	local FramesOn = false
	local OffSince = nil
	local FramesConn = nil

	local function FireWeave(State)
		local Combat = Modules.Combat

		if not Combat then
			return
		end

		pcall(function()
			Combat.Weave:Fire(State)
		end)

		if State then
			LastFire = os.clock()
		end
	end

	local function FireFlip()
		FireWeave(false)
		FireWeave(true)
	end

	local function GetLinger()
		if F.GetLinger then
			return F.GetLinger()
		end

		return 0.4
	end

	local function SignalStop()
		LingerUntil = nil
		PunchFlipAt = nil

		if SignalOn then
			SignalOn = false
			FireWeave(false)
		end
	end

	local function GetHumanoid()
		local Character = LocalPlayer.Character
		return Character and Character:FindFirstChildOfClass("Humanoid")
	end

	-- Want = you are currently in the weave state (holding weave and activated)
	local function SignalStep(Want)
		if not V2.Enabled or not Modules.Combat then
			return
		end

		local Now = os.clock()
		local Humanoid = GetHumanoid()

		if not Humanoid or Humanoid.Health <= 0 then
			SignalOn = false
			LingerUntil = nil
			return
		end

		if not HasFight() then
			SignalStop()
			return
		end

		local CanAttackNow = true

		pcall(function()
			CanAttackNow = Modules.AttackState.Active.CanAttack ~= false
		end)

		if CanAttackNow and not LastCanAttackPoll then
			PunchFlipAt = Now
		end

		LastCanAttackPoll = CanAttackNow

		if Want then
			if not SignalOn then
				PunchFlipAt = nil
			end

			SignalOn = true
			LingerUntil = nil
		elseif SignalOn and not LingerUntil then
			LingerUntil = Now + GetLinger()
		end

		if not SignalOn then
			return
		end

		if not Want and LingerUntil and Now >= LingerUntil then
			SignalOn = false
			LingerUntil = nil
			FireWeave(false)
			return
		end

		local Gap = Now - LastFire
		local Send = Gap >= math.max(FLIP_P, MIN_SPACING)

		if not Send and PunchFlipAt and Now >= PunchFlipAt and Gap >= FAST_SPACING then
			PunchFlipAt = nil
			Send = true
		end

		if not Send and not FramesOn and OffSince and Now - OffSince >= RECOVER_AFTER and Gap >= RECOVER_SPACING then
			Send = true
		end

		if Send then
			FireFlip()
		end
	end

	local function WatchFrames(Character)
		if FramesConn then
			FramesConn:Disconnect()
			FramesConn = nil
		end

		FramesOn = false
		OffSince = os.clock()

		if not Character then
			return
		end

		FramesOn = Character:GetAttribute("WeaveFrames") == true
		OffSince = (not FramesOn) and os.clock() or nil

		FramesConn = Character:GetAttributeChangedSignal("WeaveFrames"):Connect(function()
			FramesOn = Character:GetAttribute("WeaveFrames") == true

			if FramesOn then
				OffSince = nil
			elseif not OffSince then
				OffSince = os.clock()
			end
		end)
	end

	------------------------------------------------------------------
	-- Animation helpers (Isaeva script)
	------------------------------------------------------------------
	local function StopExtra()
		if ExtraTrack then
			local Track = ExtraTrack

			pcall(function()
				Track.Looped = ExtraLooped

				if Track.IsPlaying then
					Track:Stop(0.1)
				end
			end)
		end

		ExtraTrack = nil
	end

	local function StopTrack()
		StopExtra()

		if OwnTrack then
			local Track = OwnTrack

			pcall(function()
				Track.Looped = OwnLooped

				if Track.IsPlaying then
					Track:Stop(0.1)
				end
			end)
		end

		OwnTrack = nil
	end

	local function PlayTrack(Name)
		local Tracks = GetWeaveTracks and GetWeaveTracks()
		local Track = Tracks and Tracks[Name]

		if not Track then
			return false
		end

		if OwnTrack ~= Track then
			StopTrack()
			OwnLooped = Track.Looped
			OwnTrack = Track
		end

		pcall(function()
			Track.Looped = true

			if not Track.IsPlaying then
				Track:Play(0.1, 1, ANIM_SPEED)
			end
		end)

		return true
	end

	local function PlayDiag(Main, Side)
		PlayTrack(Side)

		local Tracks = GetWeaveTracks and GetWeaveTracks()
		local Track = Tracks and Tracks[Main]

		if not Track then
			return
		end

		if ExtraTrack ~= Track then
			StopExtra()
			ExtraLooped = Track.Looped
			ExtraTrack = Track
		end

		pcall(function()
			Track.Looped = true

			if not Track.IsPlaying then
				Track:Play(0.1, 0.7, ANIM_SPEED)
			end
		end)
	end

	local FloatStart, FloatStop, FloatToggle = function() end, function() end, function() end

	local function Release()
		Desired = nil
		Current = nil
		SlideId = SlideId + 1
		Sliding = false
		Holding = false
		FloatStop()
		StopTrack()

		local Humanoid = GetHumanoid()

		if Humanoid and SavedSpeed then
			Humanoid.WalkSpeed = SavedSpeed
		end

		SavedSpeed = nil

		local Character = LocalPlayer.Character
		local Root = Character and Character:FindFirstChild("HumanoidRootPart")

		if Root then
			local V = Root.AssemblyLinearVelocity
			Root.AssemblyLinearVelocity = Vector3.new(0, V.Y, 0)
		end
	end

	------------------------------------------------------------------
	-- Input: keyboard (Space + WASD), gamepad (L2 + stick),
	-- mobile (game's weave button + joystick)
	------------------------------------------------------------------
	local Hold = { Game = false }

	local function Down(Key)
		return UserInputService:IsKeyDown(Key)
	end

	local function HoldingNow()
		if Hold.Game then
			return true
		end

		if not UserInputService:GetFocusedTextBox() and Down(Enum.KeyCode.Space) then
			return true
		end

		local L2 = false

		pcall(function()
			L2 = UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonL2)
		end)

		return L2
	end

	local function SplitDirection(X, Z)
		local Main, Side

		if Z ~= 0 then
			Main = Z < 0 and "Front" or "Back"
			Side = X ~= 0 and (X > 0 and "Right" or "Left") or nil
		else
			Main = X > 0 and "Right" or "Left"
		end

		return Vector3.new(X, 0, Z).Unit, Main, Side
	end

	local function ReadKeys()
		local X, Z = 0, 0

		if Down(Enum.KeyCode.W) then
			Z = Z - 1
		end

		if Down(Enum.KeyCode.S) then
			Z = Z + 1
		end

		if Down(Enum.KeyCode.D) then
			X = X + 1
		end

		if Down(Enum.KeyCode.A) then
			X = X - 1
		end

		if X == 0 and Z == 0 then
			return nil
		end

		return SplitDirection(X, Z)
	end

	-- joystick / gamepad stick / mobile thumbstick
	local function ReadMove()
		local Character = LocalPlayer.Character
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
		local Root = Character and Character:FindFirstChild("HumanoidRootPart")

		if not Humanoid or not Root then
			return nil
		end

		local Move = Humanoid.MoveDirection

		if Move.Magnitude < 0.2 then
			return nil
		end

		local Local = Root.CFrame:VectorToObjectSpace(Move)
		local X = math.abs(Local.X) > 0.35 and (Local.X > 0 and 1 or -1) or 0
		local Z = math.abs(Local.Z) > 0.35 and (Local.Z > 0 and 1 or -1) or 0

		if X == 0 and Z == 0 then
			return nil
		end

		return SplitDirection(X, Z)
	end

	local function ReadInput()
		local Local, Main, Side = ReadKeys()

		if Local then
			return Local, Main, Side
		end

		return ReadMove()
	end

	local LastSig = nil

	local function ZeroVelocity()
		Desired = nil
		Current = nil

		local Character = LocalPlayer.Character
		local Root = Character and Character:FindFirstChild("HumanoidRootPart")

		if Root then
			local V = Root.AssemblyLinearVelocity
			Root.AssemblyLinearVelocity = Vector3.new(0, V.Y, 0)
		end
	end

	Conn(RunService.Stepped:Connect(function(_, Dt)
		if not Desired or Stopped then
			Current = nil
			return
		end

		local Character = LocalPlayer.Character
		local Root = Character and Character:FindFirstChild("HumanoidRootPart")

		if not Root then
			return
		end

		if Current and SLIDE_SMOOTH > 0 and Dt and Dt > 0 then
			Current = Current:Lerp(Desired, 1 - math.exp(-Dt / SLIDE_SMOOTH))
		else
			Current = Desired
		end

		local V = Root.AssemblyLinearVelocity
		Root.AssemblyLinearVelocity = Vector3.new(Current.X, V.Y, Current.Z)
	end))

	local function Step(Local, Main)
		local Character = LocalPlayer.Character
		local Root = Character and Character:FindFirstChild("HumanoidRootPart")

		StopExtra()

		if not Root or not PlayTrack(Main) then
			return
		end

		SlideId = SlideId + 1
		Sliding = true

		local Mine = SlideId
		local World = (Root.CFrame:VectorToWorldSpace(Local) * Vector3.new(1, 0, 1)).Unit
		local Duration = V2.Duration
		local Peak = 2 * V2.Distance / Duration

		task.spawn(function()
			local Start = os.clock()

			while Mine == SlideId and not Stopped do
				local T = (os.clock() - Start) / Duration

				if T >= 1 or not Root.Parent then
					break
				end

				local Speed = Peak * (1 - T)
				Desired = Vector3.new(World.X * Speed, 0, World.Z * Speed)
				RunService.Heartbeat:Wait()
			end

			if Mine ~= SlideId then
				return
			end

			Sliding = false
			ZeroVelocity()
		end)
	end

	local function Begin()
		local Character = LocalPlayer.Character
		local Humanoid = GetHumanoid()
		local Active = Modules.AttackState and Modules.AttackState.Active

		if not Character or not Humanoid or Humanoid.Health <= 0 or not Active then
			return false
		end

		if Active.Stomping or Active.Slamming or Active.Shoving then
			return false
		end

		Holding = true
		LastSig = nil
		FloatStart()

		if not SavedSpeed then
			SavedSpeed = Humanoid.WalkSpeed > 0 and Humanoid.WalkSpeed or 10
		end

		Humanoid.WalkSpeed = 0

		return true
	end

	local function Drive(Space)
		if not Holding then
			-- needs weave held AND a direction, so standing with fist out does nothing
			if V2.Enabled and Space and HasFight() and ReadInput() then
				Begin()
			end

			if not Holding then
				return
			end
		end

		if not V2.Enabled or not HasFight() or not Space then
			Release()
			return
		end

		local Humanoid = GetHumanoid()

		if Humanoid and Humanoid.WalkSpeed ~= 0 then
			Humanoid.WalkSpeed = 0
		end

		local Now = os.clock()
		local Local, Main, Side = ReadInput()
		local Sig = Local and (Main .. (Side or "")) or nil

		if Sig ~= LastSig then
			LastSig = Sig

			if not Sig then
				SlideId = SlideId + 1
				Sliding = false
				ZeroVelocity()
			elseif Side then
				SlideId = SlideId + 1
				Sliding = false
				JitterAt = 0
				PlayDiag(Main, Side)
			else
				Step(Local, Main)
			end
		end

		if Sig and Side then
			local Character = LocalPlayer.Character
			local Root = Character and Character:FindFirstChild("HumanoidRootPart")

			if Root then
				if Now - JitterAt >= JITTER_STEP then
					JitterAt = Now
					JitterFlip = not JitterFlip
				end

				local Factor = 1 + (JitterFlip and JITTER_AMOUNT or -JITTER_AMOUNT)
				local World = (Root.CFrame:VectorToWorldSpace(Local) * Vector3.new(1, 0, 1)).Unit
				Desired = Vector3.new(World.X * DIAG_SPEED * Factor, 0, World.Z * DIAG_SPEED * Factor)
			end

			PlayDiag(Main, Side)
		end

		if OwnTrack and not OwnTrack.IsPlaying and not Sliding and not Side then
			pcall(function()
				OwnTrack:Play(0.1, 1, ANIM_SPEED)
			end)
		end
	end

	Conn(RunService.Heartbeat:Connect(function()
		if Stopped then
			return
		end

		if V2.Enabled and not Blocked and Modules.Weave then
			Block2()
		end

		Drive(HoldingNow())

		-- signal follows the weave state: on while Holding, lingers after release
		SignalStep(Holding)
	end))

	local function WatchCharacter(Character)
		Release()
		SignalStop()
		TrackCache.Weave = nil
		WatchFrames(Character)

		if not Character then
			return
		end

		Conn(Character.ChildRemoved:Connect(function(Child)
			if Child.Name == "Fight" then
				Release()
			end
		end))
	end

	WatchCharacter(LocalPlayer.Character)

	Conn(LocalPlayer.CharacterAdded:Connect(function(Character)
		Hold.Game = false
		WatchCharacter(Character)
	end))

	local InputHookedV2 = false

	-- mobile: the game's own weave button reports through its InputController
	local function HookInput()
		if InputHookedV2 or not Modules.Input then
			return
		end

		InputHookedV2 = true

		pcall(function()
			Conn(Modules.Input.Began:Connect(function(Action)
				if Action == "Weave" then
					Hold.Game = true
				end
			end))

			Conn(Modules.Input.Ended:Connect(function(Action)
				if Action == "Weave" then
					Hold.Game = false
				end
			end))
		end)
	end

	do
		local PUSH_SPEED = 15
		local PUSH_TIME = 0.2
		local PUSH_FORCE = 100000
		local BASE_SPEED = 10
		local CUTOFF = 0.9

		local AnimSets = {
			Boxer = {
				Front = "rbxassetid://17819683172",
				Right = "rbxassetid://17819695187",
				Back = "rbxassetid://17819688197",
				Left = "rbxassetid://17819691229",
			},
			Philly = {
				Front = "rbxassetid://18312346524",
				Right = "rbxassetid://18312351760",
				Back = "rbxassetid://18312344029",
				Left = "rbxassetid://18312348771",
			},
		}

		local Set = AnimSets.Boxer
		local Enabled = false
		local Running = false
		local Facing = nil
		local Playing = nil
		local PushId = 0
		local PushBody, PushAnchor = nil, nil
		local Loaded = {}
		local LoadedFor = nil

		local function ClearPush()
			PushId = PushId + 1

			if PushBody then
				PushBody:Destroy()
				PushBody = nil
			end

			if PushAnchor then
				PushAnchor:Destroy()
				PushAnchor = nil
			end
		end

		local function Reset()
			Running = false
			Facing = nil
			ClearPush()

			if Playing then
				pcall(function()
					Playing:Stop()
				end)

				Playing = nil
			end

			local Humanoid = GetHumanoid()

			if Humanoid then
				Humanoid.WalkSpeed = BASE_SPEED
			end
		end

		local function GetTrack(Humanoid, Name)
			local Animator = Humanoid:FindFirstChildOfClass("Animator")

			if not Animator then
				return nil
			end

			if LoadedFor ~= Animator then
				Loaded = {}
				LoadedFor = Animator
			end

			local Id = Set[Name]
			local Track = Loaded[Id]

			if not Track then
				local Anim = Instance.new("Animation")
				Anim.AnimationId = Id
				Track = Animator:LoadAnimation(Anim)
				Loaded[Id] = Track
			end

			return Track
		end

		local function Push(Root, Direction)
			ClearPush()

			local Mine = PushId

			PushAnchor = Instance.new("Attachment")
			PushAnchor.Parent = Root

			PushBody = Instance.new("LinearVelocity")
			PushBody.Attachment0 = PushAnchor
			PushBody.MaxForce = PUSH_FORCE
			PushBody.VectorVelocity = Direction.Unit * PUSH_SPEED
			PushBody.Parent = Root

			task.delay(PUSH_TIME, function()
				if Mine == PushId then
					ClearPush()
				end
			end)
		end

		local function DirectionName(Root, Humanoid)
			local Local = Root.CFrame:VectorToObjectSpace(Humanoid.MoveDirection)

			if math.abs(Local.Z) > math.abs(Local.X) then
				return Local.Z < 0 and "Front" or "Back"
			end

			return Local.X > 0 and "Right" or "Left"
		end

		Conn(RunService.RenderStepped:Connect(function()
			if Stopped or not Enabled or not Running then
				return
			end

			local Character = LocalPlayer.Character
			local Humanoid = Character and Character:FindFirstChild("Humanoid")
			local Root = Character and Character:FindFirstChild("HumanoidRootPart")

			if not Humanoid or not Root then
				return
			end

			if Humanoid.MoveDirection.Magnitude < 0.2 then
				return
			end

			local Name = DirectionName(Root, Humanoid)

			if Name ~= Facing then
				Facing = Name
				Humanoid.WalkSpeed = BASE_SPEED

				if Playing then
					Playing:Stop()
				end

				Playing = GetTrack(Humanoid, Name)

				if Playing then
					Playing:Play()
				end

				Push(Root, Humanoid.MoveDirection)
			end

			if Playing and Playing.IsPlaying and Playing.TimePosition >= Playing.Length * CUTOFF then
				Humanoid.WalkSpeed = 0
			end
		end))

		task.spawn(function()
			local Stats = LocalPlayer:WaitForChild("leaderstats", 10)

			if not Stats then
				return
			end

			local StyleValue = Stats:WaitForChild("Style", 5) or Stats:FindFirstChildOfClass("StringValue")

			if not StyleValue then
				return
			end

			local function Apply(Value)
				local Text = string.lower(tostring(Value))

				if string.find(Text, "philly") then
					Set = AnimSets.Philly
					Reset()
				elseif string.find(Text, "boxer") then
					Set = AnimSets.Boxer
					Reset()
				end
			end

			Apply(StyleValue.Value)
			Conn(StyleValue.Changed:Connect(Apply))
		end)

		Conn(LocalPlayer.CharacterAdded:Connect(function()
			task.wait(0.5)
			Loaded = {}
			LoadedFor = nil
			Reset()
		end))

		-- no signal loop here any more: the weave signal lives in SignalStep above
		FloatStart = function()
			if Enabled then
				Running = true
			end
		end

		FloatStop = function()
			if Enabled then
				Reset()
			end
		end

		FloatToggle = function(State)
			Enabled = State

			if not Enabled then
				Reset()
			end
		end
	end

	F.SetWeaveV2 = function(State)
		if State and F.WeaveControl and F.WeaveControl:Get() then
			F.WeaveControl:Set(false)
		end

		V2.Enabled = State
		FloatToggle(State)

		if State then
			task.spawn(function()
				LoadModules()

				if V2.Enabled then
					Block2()
					HookInput()
				end
			end)
		else
			Hold.Game = false
			Release()
			SignalStop()
			Unblock()
		end
	end

	OnCleanup(function()
		Stopped = true
		V2.Enabled = false
		Release()
		SignalStop()
		Unblock()
		FloatToggle(false)

		if FramesConn then
			FramesConn:Disconnect()
		end
	end)
end)

