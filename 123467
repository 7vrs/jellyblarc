	function Tab:AddToggle(text, default, callback, note)
		local State = default and true or false
		local Row = RowFrame(40)

		local Label = text
		if note then
			Label = text .. '  <font size="9" color="rgb(200,200,210)">' .. note .. "</font>"
		end

		New("TextLabel", {
			Size = UDim2.new(1, -66, 1, 0),
			Position = UDim2.fromOffset(12, 0),
			BackgroundTransparency = 1,
			Text = Label,
			RichText = true,
			TextColor3 = WHITE,
			Font = Enum.Font.GothamMedium,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, Row)

		local Switch = New("TextButton", {
			Size = UDim2.fromOffset(38, 20),
			Position = UDim2.new(1, -50, 0.5, -10),
			BackgroundColor3 = THEME.TrackOff,
			Text = "",
			AutoButtonColor = false,
			BorderSizePixel = 0,
		}, Row)

		Corner(Switch, UDim.new(1, 0))

		local Knob = New("Frame", {
			Size = UDim2.fromOffset(14, 14),
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
		}, Switch)

		Corner(Knob, UDim.new(1, 0))

		local function Render(animate)
			local info = TweenInfo.new(animate and 0.15 or 0, Enum.EasingStyle.Quad)

			TweenService:Create(Switch, info, { BackgroundColor3 = State and WHITE or THEME.TrackOff }):Play()
			TweenService:Create(Knob, info, {
				Position = State and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
				BackgroundColor3 = State and THEME.Accent or WHITE,
			}):Play()
		end

		Render(false)

		Conn(Switch.MouseButton1Click:Connect(function()
			State = not State
			Render(true)

			if callback then
				task.spawn(callback, State)
			end
		end))

		local Control = {}

		function Control:Get()
			return State
		end

		function Control:Set(value)
			State = value and true or false
			Render(true)

			if callback then
				task.spawn(callback, State)
			end
		end

		if callback and State then
			task.defer(callback, State)
		end

		return Control
	end

	function Tab:AddSlider(text, min, max, step, default, callback)
		local Value = math.clamp(default or min, min, max)
		local Row = RowFrame(52)

		New("TextLabel", {
			Size = UDim2.new(1, -78, 0, 16),
			Position = UDim2.fromOffset(12, 7),
			BackgroundTransparency = 1,
			Text = text,
			TextColor3 = WHITE,
			Font = Enum.Font.GothamMedium,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, Row)

		local ValueText = New("TextLabel", {
			Size = UDim2.fromOffset(54, 16),
			Position = UDim2.new(1, -66, 0, 7),
			BackgroundTransparency = 1,
			Text = "",
			TextColor3 = WHITE,
			Font = Enum.Font.GothamBold,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Right,
		}, Row)

		local Track = New("Frame", {
			Size = UDim2.new(1, -24, 0, 6),
			Position = UDim2.new(0, 12, 0, 33),
			BackgroundColor3 = THEME.TrackOff,
			BorderSizePixel = 0,
		}, Row)

		Corner(Track, UDim.new(1, 0))

		local Fill = New("Frame", {
			Size = UDim2.new(0, 0, 1, 0),
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
		}, Track)

		Corner(Fill, UDim.new(1, 0))

		local Thumb = New("Frame", {
			Size = UDim2.fromOffset(14, 14),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
		}, Track)

		Corner(Thumb, UDim.new(1, 0))
		New("UIStroke", { Color = THEME.Accent, Thickness = 2 }, Thumb)

		local Hit = New("TextButton", {
			Size = UDim2.new(1, -24, 0, 24),
			Position = UDim2.new(0, 12, 0, 24),
			BackgroundTransparency = 1,
			Text = "",
			ZIndex = 2,
		}, Row)

		local Decimals = step < 0.1 and 2 or (step < 1 and 1 or 0)

		local function Show()
			local alpha = (Value - min) / (max - min)

			Fill.Size = UDim2.new(alpha, 0, 1, 0)
			Thumb.Position = UDim2.new(alpha, 0, 0.5, 0)
			ValueText.Text = string.format("%." .. Decimals .. "f", Value)
		end

		local function SetFromX(x)
			local alpha = math.clamp((x - Track.AbsolutePosition.X) / math.max(Track.AbsoluteSize.X, 1), 0, 1)
			local steps = math.floor((min + (max - min) * alpha - min) / step + 0.5)
			local v = math.clamp(min + steps * step, min, max)

			v = math.floor(v * 1000 + 0.5) / 1000

			if v ~= Value then
				Value = v
				Show()

				if callback then
					task.spawn(callback, Value)
				end
			end
		end

		Conn(Hit.InputBegan:Connect(function(input)
			if IsPress(input) then
				ActiveSlider = SetFromX
				SetFromX(input.Position.X)
			end
		end))

		Show()

		local Control = {}

		function Control:Get()
			return Value
		end

		return Control
	end

	function Tab:AddButton(text, callback)
		local Button = New("TextButton", {
			Size = UDim2.new(1, 0, 0, 38),
			BackgroundColor3 = WHITE,
			Text = text,
			TextColor3 = THEME.Accent,
			Font = Enum.Font.GothamBold,
			TextSize = 13,
			AutoButtonColor = false,
			BorderSizePixel = 0,
			LayoutOrder = Next(),
