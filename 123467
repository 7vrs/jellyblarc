-- animation loop (snow, border spin, emblem pulse)
------------------------------------------------------------------
local AnimClock = 0
local BorderAngle = 0

Conn(RunService.Heartbeat:Connect(function(dt)
	AnimClock += dt

	BorderAngle = (BorderAngle + 60 * dt) % 360
	StrokeGradient.Rotation = BorderAngle

	local es = 46 + 4 * (0.5 - 0.5 * math.cos(AnimClock * 2 * math.pi / 4.4))
	Emblem.Size = UDim2.fromOffset(es, es)

	local H = Main.AbsoluteSize.Y

	for _, fl in ipairs(Flakes) do
		fl.y += fl.vy * 0.7 * dt

		if fl.y > H + 6 then
			fl.y = -6
			fl.x = math.random()
		end

		fl.f.Position = UDim2.new(fl.x, math.sin(AnimClock * fl.fq + fl.ph) * fl.am, 0, fl.y)
	end
end))

