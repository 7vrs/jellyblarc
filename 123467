local function SelectTab(tab)
	Selected = tab

	for _, t in ipairs(Tabs) do
		local on = t == tab
		t.Page.Visible = on

		TweenService:Create(t.Dot, TweenInfo.new(0.15), {
			BackgroundTransparency = on and 0 or 0.8,
		}):Play()

		t.Letter.TextColor3 = on and THEME.Accent or WHITE
	end
end

