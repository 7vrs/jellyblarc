local function Block(name, fn)
	local ok, err = pcall(fn)

	if not ok then
		warn("[Jelly Blarc] " .. name .. " failed: " .. tostring(err))
	end
end

local function ParentGui(g)
	pcall(function()
		if syn and syn.protect_gui then
			syn.protect_gui(g)
		end
	end)

	pcall(function()
		g.Parent = (gethui and gethui()) or CoreGui
	end)

	if not g.Parent then
		pcall(function()
			g.Parent = LocalPlayer:WaitForChild("PlayerGui")
		end)
	end
end

