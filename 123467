Block("Movement (weave)", function()
	local WeaveOn = false
	local GlideOn = false
	local GlideDistance = 2.2
	local Linger = 0.4
	local WalkOn = false
	local WalkDefault = 11
	local WalkSetting = 11

	local SlideOn = false
	local SlideSpeed = 10

	local ANIM_SPEED = 0.9
	local FLIP_P = 0.27
	local MIN_SPACING = 0.2
	local RECOVER_AFTER = 0.05
	local RECOVER_SPACING = 0.22
	local FAST_SPACING = 0.10

	local Held = { Space = false, L2 = false, Game = false }
	local Weaving = false
	local SignalOn = false
	local LingerUntil = nil
	local LastFire = 0
	local PunchFlipAt = nil
	local LastCanAttackPoll = true
	local LastDashDirection = nil
	local DashBlockedUntil = 0
	local OwnTrack = nil
	local OwnDirection = nil
	local OwnLooped = false
	local WeaveBlocked = false
	local SpaceBound = false
	local OriginalWeave = {}
	local FramesOn = false
	local OffSince = nil
	local FramesConn = nil
	local ToolConn = nil
	local InputHooked = false
	local LockedSpeed = nil
	local MomentumCleared = false
	local TrackCache = { Character = nil, Style = nil, Weave = nil }

	local Offsets = {
		Front = CFrame.new(0, 0, -2.2),
		Back = CFrame.new(0, 0, 2.2),
		Right = CFrame.new(2.2, 0, 0),
		Left = CFrame.new(-2.2, 0, 0),
	}

	local function SpaceHeld()
		return Held.Space or Held.L2 or Held.Game
	end

	local function ClearHeld()
		Held.Space = false
		Held.L2 = false
		Held.Game = false
	end

	local function WalkCustom()
		return WalkOn and math.abs(WalkSetting - WalkDefault) > 0.01
	end

	local function RestoreWalkSpeed()
		local Character = LocalPlayer.Character
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

		if Humanoid and not Weaving then
			Humanoid.WalkSpeed = WalkDefault
		end
	end

	local function GetWeaveTracks()
		local AttackState = Modules.AttackState
		local Character = LocalPlayer.Character

		if not AttackState or not Character then
			return nil
		end

		local Style
		pcall(function()
			Style = AttackState.StyleName()
		end)

		if TrackCache.Weave and TrackCache.Character == Character and TrackCache.Style == Style then
			return TrackCache.Weave
		end

		local Weave
		pcall(function()
			local Set = AttackState.StyleSet()
			Weave = Set and Set.Weave
		end)

		TrackCache.Character = Character
		TrackCache.Style = Style
		TrackCache.Weave = Weave

		return Weave
	end

	local function CurrentDirection()
		local Character = LocalPlayer.Character
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
		local Root = Character and Character:FindFirstChild("HumanoidRootPart")

		if not Humanoid or not Root then
			return nil
		end

		local Move = Humanoid.MoveDirection

		if Move.Magnitude <= 0 then
			return nil
		end

		local Forward = Move:Dot(Root.CFrame.LookVector)
		local Side = Move:Dot(Root.CFrame.RightVector)

		if Forward >= 0.5 then
			return "Front", Root
		elseif Forward <= -0.5 then
			return "Back", Root
		elseif Side >= 0.9 then
			return "Right", Root
		elseif Side <= -0.9 then
			return "Left", Root
		end

		return nil
	end

	local function StopOwnTrack()
		if OwnTrack then
			local Track = OwnTrack

			pcall(function()
				Track.Looped = OwnLooped

				if Track.IsPlaying then
					Track:Stop()
				end
			end)
		end

		OwnTrack = nil
		OwnDirection = nil
	end

	local function Dash(Root, Direction)
		if not GlideOn then
			return
		end

		local Now = os.clock()

		if Now < DashBlockedUntil or LastDashDirection == Direction then
			return
		end

		local Existing = Root:FindFirstChildOfClass("BodyPosition")

		if Existing then
			Existing:Destroy()
			return
		end

		LastDashDirection = Direction
		DashBlockedUntil = Now + 0.3

		local Way = (Root.CFrame * Offsets[Direction]).Position - Root.Position

		if Way.Magnitude <= 0 then
			return
		end

		local Target = Root.Position + Way.Unit * GlideDistance
		local Made = false

		if Modules.Movers then
			Made = pcall(function()
				Modules.Movers.Create("BodyPosition", "WeaveMove", {
					MaxForce = Vector3.new(30000, 0, 30000),
					P = 220,
					D = 0,
					Position = Target,
				}, Root, 0.1)
			end)
		end

		if not Made then
			local Mover = Instance.new("BodyPosition")
			Mover.Name = "WeaveMove"
			Mover.MaxForce = Vector3.new(30000, 0, 30000)
			Mover.P = 220
			Mover.D = 0
			Mover.Position = Target
			Mover.Parent = Root

			task.delay(0.1, function()
				if Mover.Parent then
					Mover:Destroy()
				end
			end)
		end
	end

	local function UpdateWeave()
		local Direction, Root = CurrentDirection()

		if not Direction then
			StopOwnTrack()
			return
		end

		local Tracks = GetWeaveTracks()
		local Track = Tracks and Tracks[Direction]

		if not Track then
			return
		end

		if OwnTrack == Track and Track.IsPlaying then
			pcall(function()
				if math.abs(Track.Speed - ANIM_SPEED) > 0.01 then
					Track:AdjustSpeed(ANIM_SPEED)
				end
			end)

			return
		end

		if OwnTrack and OwnTrack ~= Track then
			StopOwnTrack()
		end

		if OwnTrack ~= Track then
			OwnLooped = Track.Looped
			OwnTrack = Track
		end

		Track.Looped = true
		Track:Play(0.1, 1, ANIM_SPEED)

		if OwnDirection ~= Direction then
			OwnDirection = Direction
			Dash(Root, Direction)
		end
	end

	local function FireWeave(State)
		local Combat = Modules.Combat

		if not Combat then
			return
		end

		pcall(function()
			Combat.Weave:Fire(State)
		end)

		if State then
			LastFire = os.clock()
		end
	end

	local function FireFlip()
		FireWeave(false)
		FireWeave(true)
	end

	local function StopWeave()
		Weaving = false
		LastDashDirection = nil
		LingerUntil = nil

		if SignalOn then
			SignalOn = false
			FireWeave(false)
		end

		StopOwnTrack()
	end

	local function Tick()
		if not WeaveOn or not Modules.Combat then
			return
		end

		local Now = os.clock()
		local Character = LocalPlayer.Character
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
		local Alive = Humanoid ~= nil and Humanoid.Health > 0

		if not Alive then
			Weaving = false
			SignalOn = false
			LingerUntil = nil
			StopOwnTrack()
			return
		end

		if not HasFight() then
			if SpaceHeld() or Weaving or SignalOn then
				ClearHeld()
				StopWeave()
			end

			return
		end

		local CanAttackNow = true

		pcall(function()
			CanAttackNow = Modules.AttackState.Active.CanAttack ~= false
		end)

		if CanAttackNow and not LastCanAttackPoll then
			PunchFlipAt = Now
		end

		LastCanAttackPoll = CanAttackNow

		local Moving = Humanoid.MoveDirection.Magnitude > 0.05
		local WantWeave = SpaceHeld() and Moving

		if WantWeave then
			if not Weaving then
				Weaving = true
				LastDashDirection = nil
			end

			if not SignalOn then
				PunchFlipAt = nil
			end

			SignalOn = true
			LingerUntil = nil

			UpdateWeave()
		elseif Weaving then
			Weaving = false
			LastDashDirection = nil
			StopOwnTrack()

			if SignalOn then
				LingerUntil = Now + Linger
			end
		end

		if SignalOn then
			if not WantWeave and LingerUntil and Now >= LingerUntil then
				SignalOn = false
				LingerUntil = nil
				FireWeave(false)
			else
				local Gap = Now - LastFire
				local Send = Gap >= math.max(FLIP_P, MIN_SPACING)

				if not Send and PunchFlipAt and Now >= PunchFlipAt and Gap >= FAST_SPACING then
					PunchFlipAt = nil
					Send = true
				end

				if not Send and not FramesOn and OffSince and Now - OffSince >= RECOVER_AFTER and Gap >= RECOVER_SPACING then
					Send = true
				end

				if Send then
					FireFlip()
				end
			end
		end
	end

	local function BlockGameWeave()
		if WeaveBlocked or SpaceBound or not Modules.Weave then
			return
		end

		local W = Modules.Weave
		local Ok = pcall(function()
			OriginalWeave.Set = W.Set
			OriginalWeave.Play = W.Play
			OriginalWeave.StopTrack = W.StopTrack
			OriginalWeave.Reset = W.Reset

			W.Set = function() end
			W.Play = function() end
			W.StopTrack = function() end
			W.Reset = function() end
		end)

		if Ok and W.Set ~= OriginalWeave.Set then
			WeaveBlocked = true

			if Modules.AttackState and Modules.AttackState.Active then
				Modules.AttackState.Active.Weaving = false
			end
		else
			pcall(function()
				W.Set = OriginalWeave.Set or W.Set
				W.Play = OriginalWeave.Play or W.Play
				W.StopTrack = OriginalWeave.StopTrack or W.StopTrack
				W.Reset = OriginalWeave.Reset or W.Reset
			end)

			SpaceBound = true

			ContextActionService:BindActionAtPriority(
				"JellyBlockSpace",
				function()
					return Enum.ContextActionResult.Sink
				end,
				false,
				Enum.ContextActionPriority.High.Value + 1,
				Enum.KeyCode.Space
			)
		end
	end

	local function UnblockGameWeave()
		if WeaveBlocked and Modules.Weave then
			pcall(function()
				Modules.Weave.Set = OriginalWeave.Set
				Modules.Weave.Play = OriginalWeave.Play
				Modules.Weave.StopTrack = OriginalWeave.StopTrack
				Modules.Weave.Reset = OriginalWeave.Reset
			end)
		end

		WeaveBlocked = false

		if SpaceBound then
			SpaceBound = false
			ContextActionService:UnbindAction("JellyBlockSpace")
		end
	end

	local function HookGameInput()
		if InputHooked or not Modules.Input then
			return
		end

		InputHooked = true

		pcall(function()
			Modules.Input.Began:Connect(function(Action)
				if Action == "Weave" and WeaveOn and HasFight() then
					Held.Game = true
					Tick()
				end
			end)

			Modules.Input.Ended:Connect(function(Action)
				if Action == "Weave" then
					Held.Game = false
					Tick()
				end
			end)
		end)
	end

	local function EnforceNoSlide()
		local Character = LocalPlayer.Character
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

		if not Humanoid then
			LockedSpeed = nil
			return
		end

		local Running = WeaveOn and Weaving and HasFight() and not SlideOn

		if Running then
			if not LockedSpeed and Humanoid.WalkSpeed > 0 then
				LockedSpeed = Humanoid.WalkSpeed
			end

			if LockedSpeed and Humanoid.WalkSpeed ~= 0 then
				Humanoid.WalkSpeed = 0
			end

			if not MomentumCleared then
				MomentumCleared = true

				local Root = Character:FindFirstChild("HumanoidRootPart")

				if Root then
					local Velocity = Root.AssemblyLinearVelocity
					Root.AssemblyLinearVelocity = Vector3.new(0, Velocity.Y, 0)
				end
			end
		else
			MomentumCleared = false

			if LockedSpeed then
				if Humanoid.WalkSpeed == 0 then
					Humanoid.WalkSpeed = WalkCustom() and WalkSetting or LockedSpeed
				end

				LockedSpeed = nil
			end
		end
	end

	local function WatchFrames(Character)
		if FramesConn then
			FramesConn:Disconnect()
			FramesConn = nil
		end

		FramesOn = false
		OffSince = os.clock()

		if not Character then
			return
		end

		FramesOn = Character:GetAttribute("WeaveFrames") == true
		OffSince = (not FramesOn) and os.clock() or nil

		FramesConn = Character:GetAttributeChangedSignal("WeaveFrames"):Connect(function()
			FramesOn = Character:GetAttribute("WeaveFrames") == true

			if FramesOn then
				OffSince = nil
			elseif not OffSince then
				OffSince = os.clock()
			end
		end)
	end

	local function WatchTools(Character)
		if ToolConn then
			ToolConn:Disconnect()
			ToolConn = nil
		end

		if not Character then
			return
		end

		ToolConn = Character.ChildRemoved:Connect(function(Child)
			if Child.Name == "Fight" and WeaveOn then
				ClearHeld()
				StopWeave()
			end
		end)
	end

	pcall(function()
		RunService:UnbindFromRenderStep("JellyNoSlide")
	end)

	RunService:BindToRenderStep("JellyNoSlide", Enum.RenderPriority.Last.Value, EnforceNoSlide)
	Conn(RunService.Heartbeat:Connect(EnforceNoSlide))

	Conn(RunService.RenderStepped:Connect(function()
		if not WalkCustom() or Weaving then
			return
		end

		local Character = LocalPlayer.Character
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

		if Humanoid and Humanoid.Health > 0 and Humanoid.WalkSpeed ~= WalkSetting then
			Humanoid.WalkSpeed = WalkSetting
		end
	end))

	if LocalPlayer.Character then
		WatchFrames(LocalPlayer.Character)
		WatchTools(LocalPlayer.Character)
	end

	Conn(LocalPlayer.CharacterAdded:Connect(function(Character)
		WatchFrames(Character)
		WatchTools(Character)

		TrackCache.Weave = nil
		OwnTrack = nil
		OwnDirection = nil
		LastDashDirection = nil

		Held.Space = UserInputService:IsKeyDown(Enum.KeyCode.Space)
		Held.L2 = false
		Held.Game = false
	end))

	Conn(UserInputService.InputBegan:Connect(function(Input)
		if not WeaveOn then
			return
		end

		if Input.KeyCode == Enum.KeyCode.Space then
			if UserInputService:GetFocusedTextBox() or not HasFight() then
				return
			end

			Held.Space = true
			Tick()
		elseif Input.KeyCode == Enum.KeyCode.ButtonL2 then
			if not HasFight() then
				return
			end

			Held.L2 = true
			Tick()
		end
	end))

	Conn(UserInputService.InputEnded:Connect(function(Input)
		if Input.KeyCode == Enum.KeyCode.Space then
			Held.Space = false
			Tick()
		elseif Input.KeyCode == Enum.KeyCode.ButtonL2 then
			Held.L2 = false
			Tick()
		end
	end))

	Conn(UserInputService.WindowFocusReleased:Connect(ClearHeld))

	Conn(RunService.Heartbeat:Connect(Tick))

	local function SetWeave(State)
		if State and F.WeaveV2Control and F.WeaveV2Control:Get() then
			F.WeaveV2Control:Set(false)
		end

		WeaveOn = State

		if State then
			task.spawn(function()
				if LoadModules() and WeaveOn then
					BlockGameWeave()
				end

				HookGameInput()
			end)
		else
			ClearHeld()
			StopWeave()
			UnblockGameWeave()
		end
	end

