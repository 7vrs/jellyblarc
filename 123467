-- SPEED: punch / stomp animation speed
------------------------------------------------------------------
local PunchSpeed = 1.7
local StompSpeed = 1

local PUNCH_IDS = {
	"18312333191", "18312335714", "18312338197", "18312340119",
	"17819438450", "17819441388", "17819444004", "17819446225",
}

local STOMP_IDS = { "18362264385", "17837722603" }

local TrackKinds = setmetatable({}, { __mode = "k" })

local function HasAnimId(Track, Ids)
	local Animation = Track.Animation

	if not Animation then
		return false
	end

	local AnimId = tostring(Animation.AnimationId)

	for _, Id in ipairs(Ids) do
		if string.find(AnimId, Id, 1, true) then
			return true
		end
	end

	return false
end

local function KindOf(Track)
	local Cached = TrackKinds[Track]

	if Cached ~= nil then
		return Cached
	end

	local Kind = false

	if HasAnimId(Track, PUNCH_IDS) then
		Kind = "punch"
	elseif HasAnimId(Track, STOMP_IDS) then
		Kind = "stomp"
	end

	TrackKinds[Track] = Kind

	return Kind
end

Conn(RunService.Heartbeat:Connect(function()
	local Character = LocalPlayer.Character
	local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
	local Animator = Humanoid and Humanoid:FindFirstChildOfClass("Animator")

	if not Animator then
		return
	end

	for _, Track in ipairs(Animator:GetPlayingAnimationTracks()) do
		local Kind = KindOf(Track)

		if Kind then
			local Wanted = Kind == "punch" and PunchSpeed or StompSpeed

			if Kind == "punch" or Wanted > 1 then
				local Speed = Track.Speed

				if Speed > 0.1 and math.abs(Speed - Wanted) > 0.02 then
					pcall(function()
						Track:AdjustSpeed(Wanted)
					end)
				end
			end
		end
	end
end))

------------------------------------------------------------------
-- WEAVE (movement tab)
------------------------------------------------------------------
local WeaveOn = false
local GlideOn = false
local GlideDistance = 2.2
local Linger = 0.4
local WalkOn = false
local WalkDefault = 11
local WalkSetting = 11

local SlideOn = false
local SlideSpeed = 10

local ANIM_SPEED = 0.9
local FLIP_P = 0.27
local MIN_SPACING = 0.2
local RECOVER_AFTER = 0.05
local RECOVER_SPACING = 0.22
local FAST_SPACING = 0.10

local Held = { Space = false, L2 = false, Game = false }
local Weaving = false
local SignalOn = false
local LingerUntil = nil
local LastFire = 0
local PunchFlipAt = nil
local LastCanAttackPoll = true
local LastDashDirection = nil
local DashBlockedUntil = 0
local OwnTrack = nil
local OwnDirection = nil
local OwnLooped = false
local WeaveBlocked = false
local SpaceBound = false
local OriginalWeave = {}
local FramesOn = false
local OffSince = nil
local FramesConn = nil
local ToolConn = nil
local InputHooked = false
local LockedSpeed = nil
local MomentumCleared = false
local TrackCache = { Character = nil, Style = nil, Weave = nil }

local Offsets = {
	Front = CFrame.new(0, 0, -2.2),
	Back = CFrame.new(0, 0, 2.2),
	Right = CFrame.new(2.2, 0, 0),
	Left = CFrame.new(-2.2, 0, 0),
}

local function SpaceHeld()
	return Held.Space or Held.L2 or Held.Game
end

local function ClearHeld()
	Held.Space = false
	Held.L2 = false
	Held.Game = false
end

local function WalkCustom()
	return WalkOn and math.abs(WalkSetting - WalkDefault) > 0.01
end

local function RestoreWalkSpeed()
	local Character = LocalPlayer.Character
	local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

	if Humanoid and not Weaving then
		Humanoid.WalkSpeed = WalkDefault
	end
end

local function GetWeaveTracks()
	local AttackState = Modules.AttackState
	local Character = LocalPlayer.Character

	if not AttackState or not Character then
		return nil
	end

	local Style
	pcall(function()
		Style = AttackState.StyleName()
	end)

	if TrackCache.Weave and TrackCache.Character == Character and TrackCache.Style == Style then
		return TrackCache.Weave
	end

	local Weave
	pcall(function()
		local Set = AttackState.StyleSet()
		Weave = Set and Set.Weave
	end)

	TrackCache.Character = Character
	TrackCache.Style = Style
	TrackCache.Weave = Weave

	return Weave
end

local function CurrentDirection()
	local Character = LocalPlayer.Character
	local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
	local Root = Character and Character:FindFirstChild("HumanoidRootPart")

	if not Humanoid or not Root then
		return nil
	end

	local Move = Humanoid.MoveDirection

	if Move.Magnitude <= 0 then
		return nil
	end

	local Forward = Move:Dot(Root.CFrame.LookVector)
	local Side = Move:Dot(Root.CFrame.RightVector)

	if Forward >= 0.5 then
		return "Front", Root
	elseif Forward <= -0.5 then
		return "Back", Root
	elseif Side >= 0.9 then
		return "Right", Root
	elseif Side <= -0.9 then
		return "Left", Root
	end

	return nil
end

local function StopOwnTrack()
	if OwnTrack then
		local Track = OwnTrack

		pcall(function()
			Track.Looped = OwnLooped

			if Track.IsPlaying then
				Track:Stop()
			end
		end)
	end

	OwnTrack = nil
	OwnDirection = nil
end

local function Dash(Root, Direction)
	if not GlideOn then
		return
	end

	local Now = os.clock()

	if Now < DashBlockedUntil or LastDashDirection == Direction then
		return
	end

	local Existing = Root:FindFirstChildOfClass("BodyPosition")

	if Existing then
		Existing:Destroy()
		return
	end

	LastDashDirection = Direction
	DashBlockedUntil = Now + 0.3

	local Way = (Root.CFrame * Offsets[Direction]).Position - Root.Position

	if Way.Magnitude <= 0 then
		return
	end

	local Target = Root.Position + Way.Unit * GlideDistance
	local Made = false

	if Modules.Movers then
		Made = pcall(function()
			Modules.Movers.Create("BodyPosition", "WeaveMove", {
				MaxForce = Vector3.new(30000, 0, 30000),
				P = 220,
				D = 0,
				Position = Target,
			}, Root, 0.1)
		end)
	end

	if not Made then
		local Mover = Instance.new("BodyPosition")
		Mover.Name = "WeaveMove"
		Mover.MaxForce = Vector3.new(30000, 0, 30000)
		Mover.P = 220
		Mover.D = 0
		Mover.Position = Target
		Mover.Parent = Root

		task.delay(0.1, function()
			if Mover.Parent then
				Mover:Destroy()
			end
		end)
	end
end

local function UpdateWeave()
	local Direction, Root = CurrentDirection()

	if not Direction then
		StopOwnTrack()
		return
	end

	local Tracks = GetWeaveTracks()
	local Track = Tracks and Tracks[Direction]

	if not Track then
		return
	end

	if OwnTrack == Track and Track.IsPlaying then
		pcall(function()
			if math.abs(Track.Speed - ANIM_SPEED) > 0.01 then
				Track:AdjustSpeed(ANIM_SPEED)
			end
		end)

		return
	end

	if OwnTrack and OwnTrack ~= Track then
		StopOwnTrack()
	end

	if OwnTrack ~= Track then
		OwnLooped = Track.Looped
		OwnTrack = Track
	end

	Track.Looped = true
	Track:Play(0.1, 1, ANIM_SPEED)

	if OwnDirection ~= Direction then
		OwnDirection = Direction
		Dash(Root, Direction)
	end
end

local function FireWeave(State)
	local Combat = Modules.Combat

	if not Combat then
		return
	end

	pcall(function()
		Combat.Weave:Fire(State)
	end)

	if State then
		LastFire = os.clock()
	end
end

local function FireFlip()
	FireWeave(false)
	FireWeave(true)
end

local function StopWeave()
	Weaving = false
	LastDashDirection = nil
	LingerUntil = nil

	if SignalOn then
		SignalOn = false
		FireWeave(false)
	end

	StopOwnTrack()
end

local function Tick()
	if not WeaveOn or not Modules.Combat then
		return
	end

	local Now = os.clock()
	local Character = LocalPlayer.Character
	local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
	local Alive = Humanoid ~= nil and Humanoid.Health > 0

	if not Alive then
		Weaving = false
		SignalOn = false
		LingerUntil = nil
		StopOwnTrack()
		return
	end

	if not HasFight() then
		if SpaceHeld() or Weaving or SignalOn then
			ClearHeld()
			StopWeave()
		end

		return
	end

	local CanAttackNow = true

	pcall(function()
		CanAttackNow = Modules.AttackState.Active.CanAttack ~= false
	end)

	if CanAttackNow and not LastCanAttackPoll then
		PunchFlipAt = Now
	end

	LastCanAttackPoll = CanAttackNow

	local Moving = Humanoid.MoveDirection.Magnitude > 0.05
	local WantWeave = SpaceHeld() and Moving

	if WantWeave then
		if not Weaving then
			Weaving = true
			LastDashDirection = nil
		end

		if not SignalOn then
			PunchFlipAt = nil
		end

		SignalOn = true
		LingerUntil = nil

		UpdateWeave()
	elseif Weaving then
		Weaving = false
		LastDashDirection = nil
		StopOwnTrack()

		if SignalOn then
			LingerUntil = Now + Linger
		end
	end

	if SignalOn then
		if not WantWeave and LingerUntil and Now >= LingerUntil then
			SignalOn = false
			LingerUntil = nil
			FireWeave(false)
		else
			local Gap = Now - LastFire
			local Send = Gap >= math.max(FLIP_P, MIN_SPACING)

			if not Send and PunchFlipAt and Now >= PunchFlipAt and Gap >= FAST_SPACING then
				PunchFlipAt = nil
				Send = true
			end

			if not Send and not FramesOn and OffSince and Now - OffSince >= RECOVER_AFTER and Gap >= RECOVER_SPACING then
				Send = true
			end

			if Send then
				FireFlip()
			end
		end
	end
end

local function BlockGameWeave()
	if WeaveBlocked or SpaceBound or not Modules.Weave then
		return
	end

	local W = Modules.Weave
	local Ok = pcall(function()
		OriginalWeave.Set = W.Set
		OriginalWeave.Play = W.Play
		OriginalWeave.StopTrack = W.StopTrack
		OriginalWeave.Reset = W.Reset

		W.Set = function() end
		W.Play = function() end
		W.StopTrack = function() end
		W.Reset = function() end
	end)

	if Ok and W.Set ~= OriginalWeave.Set then
		WeaveBlocked = true

		if Modules.AttackState and Modules.AttackState.Active then
			Modules.AttackState.Active.Weaving = false
		end
	else
		pcall(function()
			W.Set = OriginalWeave.Set or W.Set
			W.Play = OriginalWeave.Play or W.Play
			W.StopTrack = OriginalWeave.StopTrack or W.StopTrack
			W.Reset = OriginalWeave.Reset or W.Reset
		end)

		SpaceBound = true

		ContextActionService:BindActionAtPriority(
			"JellyBlockSpace",
			function()
				return Enum.ContextActionResult.Sink
			end,
			false,
			Enum.ContextActionPriority.High.Value + 1,
			Enum.KeyCode.Space
		)
	end
end

local function UnblockGameWeave()
	if WeaveBlocked and Modules.Weave then
		pcall(function()
			Modules.Weave.Set = OriginalWeave.Set
			Modules.Weave.Play = OriginalWeave.Play
			Modules.Weave.StopTrack = OriginalWeave.StopTrack
			Modules.Weave.Reset = OriginalWeave.Reset
		end)
	end

	WeaveBlocked = false

	if SpaceBound then
		SpaceBound = false
		ContextActionService:UnbindAction("JellyBlockSpace")
	end
end

local function HookGameInput()
	if InputHooked or not Modules.Input then
		return
	end

	InputHooked = true

