local Modules = {}

local function LoadModules()
	if Modules.Weave and Modules.AttackState and Modules.Combat then
		return true
	end

	local Ok, Err = pcall(function()
		local Client = ReplicatedStorage:WaitForChild("Client", 10)
		local Shared = ReplicatedStorage:WaitForChild("Shared", 10)

		Modules.Weave = require(Client.Combat.Weave)
		Modules.AttackState = require(Client.Combat.AttackState)
		Modules.Remotes = require(Shared.Net.Remotes)
		Modules.Movers = require(Shared.Util.Movers)
		Modules.Combat = Modules.Remotes.Client("CombatService")
	end)

	if not Ok then
		warn("[Jelly Blarc] could not load the game's modules: " .. tostring(Err))
	end

	if not Modules.Input then
		pcall(function()
			local Client = ReplicatedStorage:WaitForChild("Client", 10)
			Modules.Input = require(Client.Controllers.InputController)
		end)
	end

	return Modules.Weave ~= nil and Modules.AttackState ~= nil and Modules.Combat ~= nil
end

task.spawn(LoadModules)

local LastLoadTry = 0

local function EnsureModules()
	if Modules.AttackState and Modules.Combat then
		return true
	end

	local Now = os.clock()

	if Now - LastLoadTry > 2 then
		LastLoadTry = Now
		task.spawn(LoadModules)
	end

	return false
end

local function HasFight()
	local Character = LocalPlayer.Character
	return Character ~= nil and Character:FindFirstChild("Fight") ~= nil
end

local function IsAlive()
	local Character = LocalPlayer.Character
	local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
	return Humanoid ~= nil and Humanoid.Health > 0
end

local HAND_PARTS = { "RightHand", "LeftHand", "Right Arm", "Left Arm" }

local function ClosestLimb(Character, Names, Position)
	local Best = nil
	local BestDistance = math.huge

	for _, Name in ipairs(Names) do
		local Part = Character:FindFirstChild(Name)

		if Part and Part:IsA("BasePart") then
			local Distance = (Part.Position - Position).Magnitude

			if Distance < BestDistance then
				BestDistance = Distance
				Best = Part
			end
		end
	end

	return Best or Character:FindFirstChild("HumanoidRootPart")
end

local function NearestTarget(Range)
	local Character = LocalPlayer.Character
	local Root = Character and Character:FindFirstChild("HumanoidRootPart")

	if not Root then
		return nil
	end

	local Best = nil
	local BestDistance = Range
	local Seen = {}

	local function Check(Model)
		if not Model or Model == Character or Seen[Model] or not Model:IsA("Model") then
			return
		end

		Seen[Model] = true

		local TargetRoot = Model:FindFirstChild("HumanoidRootPart")
		local Humanoid = Model:FindFirstChildOfClass("Humanoid")

		if not TargetRoot or not Humanoid or Humanoid.Health <= 0 then
			return
		end

		local Distance = (TargetRoot.Position - Root.Position).Magnitude

		if Distance <= BestDistance then
			BestDistance = Distance
			Best = Model
		end
	end

	for _, Player in ipairs(Players:GetPlayers()) do
		if Player ~= LocalPlayer then
			Check(Player.Character)
		end
	end

	local Live = workspace:FindFirstChild("Live")

	if Live then
		for _, Child in ipairs(Live:GetChildren()) do
			Check(Child)
		end
	end

	return Best
end

