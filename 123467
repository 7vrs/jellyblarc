Block("Combat (delays/speed)", function()
	local NoPunchOn = false
	local NoStompOn = false
	local PunchGap = 0.1
	local StompGap = 0
	local LastCanAttack = true
	local LockStartedAt = 0
	local LastStomping = false
	local StompStartedAt = 0

	Conn(RunService.Heartbeat:Connect(function()
		if not NoPunchOn and not NoStompOn then
			LastCanAttack = true
			LastStomping = false
			return
		end

		if not EnsureModules() then
			return
		end

		local Now = os.clock()

		pcall(function()
			local Active = Modules.AttackState.Active

			if not Active then
				return
			end

			if NoPunchOn then
				local CanAttack = Active.CanAttack

				if CanAttack == false and LastCanAttack ~= false then
					LockStartedAt = Now
				end

				LastCanAttack = CanAttack

				if CanAttack == false and IsAlive() and Now - LockStartedAt >= PunchGap then
					Active.CanAttack = true
					LastCanAttack = true
				end
			end

			local Stomping = Active.Stomping == true
			local Started = Stomping and not LastStomping
			LastStomping = Stomping

			if Started and Active.CurrentKind == "Stomp" then
				StompStartedAt = Now
			end

			if NoStompOn and Active.CurrentKind == "Stomp" and Now - StompStartedAt >= StompGap then
				local Track = Active.CurrentAction

				if Track and Track.IsPlaying then
					Active.CanAttack = true
					Active.Stomping = false
				end
			end
		end)
	end))

	local function SetNoPunchDelay(State)
		NoPunchOn = State

		if State then
			task.spawn(LoadModules)
		end
	end

	local function SetNoStompDelay(State)
		NoStompOn = State

		if State then
			task.spawn(LoadModules)
		end
	end

	local AntiStunOn = false
	local BaseSpeeds = setmetatable({}, { __mode = "k" })

	Conn(RunService.Heartbeat:Connect(function()
		if not AntiStunOn then
			return
		end

		if not EnsureModules() then
			return
		end

		local Active = Modules.AttackState.Active
		local M1 = Active and Active.CurrentM1

		if not M1 then
			return
		end

		pcall(function()
			if not M1.IsPlaying then
				return
			end

			local Speed = M1.Speed

			if BaseSpeeds[M1] == nil and Speed > 0.2 then
				BaseSpeeds[M1] = Speed
			end

			if Speed > 0 and Speed <= 0.1 then
				M1:AdjustSpeed(BaseSpeeds[M1] or 1)
			end
		end)
	end))

	local function SetAntiStun(State)
		AntiStunOn = State

		if State then
			task.spawn(LoadModules)
		end
	end

	local PunchSpeed = 1.7
	local StompSpeed = 1

	local PUNCH_IDS = {
		"18312333191", "18312335714", "18312338197", "18312340119",
		"17819438450", "17819441388", "17819444004", "17819446225",
	}

	local STOMP_IDS = { "18362264385", "17837722603" }

	local TrackKinds = setmetatable({}, { __mode = "k" })

	local function HasAnimId(Track, Ids)
		local Animation = Track.Animation

		if not Animation then
			return false
		end

		local AnimId = tostring(Animation.AnimationId)

		for _, Id in ipairs(Ids) do
			if string.find(AnimId, Id, 1, true) then
				return true
			end
		end

		return false
	end

	local function KindOf(Track)
		local Cached = TrackKinds[Track]

		if Cached ~= nil then
			return Cached
		end

		local Kind = false

		if HasAnimId(Track, PUNCH_IDS) then
			Kind = "punch"
		elseif HasAnimId(Track, STOMP_IDS) then
			Kind = "stomp"
		end

		TrackKinds[Track] = Kind

		return Kind
	end

	Conn(RunService.Heartbeat:Connect(function()
		local Character = LocalPlayer.Character
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
		local Animator = Humanoid and Humanoid:FindFirstChildOfClass("Animator")

		if not Animator then
			return
		end

		for _, Track in ipairs(Animator:GetPlayingAnimationTracks()) do
			local Kind = KindOf(Track)

			if Kind then
				local Wanted = Kind == "punch" and PunchSpeed or StompSpeed

				if Kind == "punch" or Wanted > 1 then
					local Speed = Track.Speed

					if Speed > 0.1 and math.abs(Speed - Wanted) > 0.02 then
						pcall(function()
							Track:AdjustSpeed(Wanted)
						end)
					end
				end
			end
		end
	end))

	F.SetNoPunchDelay = SetNoPunchDelay
	F.SetNoStompDelay = SetNoStompDelay
	F.SetAntiStun = SetAntiStun
	F.SetPunchGap = function(Value)
		PunchGap = Value
	end
	F.SetStompGap = function(Value)
		StompGap = Value
	end
	F.SetPunchSpeed = function(Value)
		PunchSpeed = Value
	end
	F.SetStompSpeed = function(Value)
		StompSpeed = Value
	end
end)

